        <!-- Replication Types -->
        <mxCell id="types_title" value="복제 유형 비교" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="1020" height="30" as="geometry" />
        </mxCell>

        <!-- Synchronous -->
        <mxCell id="sync_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sync_title" value="동기 복제 (Synchronous)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="110" y="490" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sync_content" value="설정: synchronous_standby_names = '*'&#xa;&#xa;동작:&#xa;• Primary가 COMMIT 시&#xa;• Standby가 WAL 받을 때까지 대기&#xa;• Standby 확인 후 커밋 완료&#xa;&#xa;장점: ✓ 데이터 손실 제로 (zero loss)&#xa;단점: ✗ 성능 저하 (대기 시간 증가)&#xa;&#xa;사용: 금융, 의료 등 중요 시스템" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="90" y="515" width="310" height="115" as="geometry" />
        </mxCell>

        <!-- Asynchronous -->
        <mxCell id="async_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="async_title" value="비동기 복제 (Asynchronous)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="470" y="490" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="async_content" value="설정: (기본값)&#xa;&#xa;동작:&#xa;• Primary가 즉시 COMMIT&#xa;• Standby로 비동기 전송&#xa;• Standby 확인 안 기다림&#xa;&#xa;장점: ✓ 빠름 (성능 우수)&#xa;단점: ✗ Primary 장애 시 일부 손실 가능&#xa;&#xa;사용: 일반적인 웹 애플리케이션" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="450" y="515" width="310" height="115" as="geometry" />
        </mxCell>

        <!-- Logical Replication -->
        <mxCell id="logical_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="480" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="logical_title" value="논리 복제 (Logical)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="490" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="logical_content" value="설정: CREATE PUBLICATION / SUBSCRIPTION&#xa;&#xa;동작:&#xa;• 테이블 단위 복제&#xa;• 행 단위 변경 사항 복제&#xa;• 다른 버전/OS 간 가능&#xa;&#xa;장점: ✓ 선택적 복제, 버전 독립적&#xa;단점: ✗ DDL 복제 안 됨&#xa;&#xa;사용: 데이터 통합, 마이그레이션" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="810" y="515" width="280" height="115" as="geometry" />
        </mxCell>

        <!-- Failover scenario -->
        <mxCell id="failover_title" value="장애 조치 (Failover) 시나리오" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="660" width="1020" height="30" as="geometry" />
        </mxCell>

        <mxCell id="failover_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="1020" height="90" as="geometry" />
        </mxCell>

        <mxCell id="failover_content" value="1. Primary 서버 장애 감지 (모니터링 도구: Patroni, repmgr 등)&#xa;2. Standby 서버 승격 (promote): pg_ctl promote 또는 pg_promote()&#xa;3. Standby가 복구 모드 종료, 읽기/쓰기 가능한 Primary로 전환&#xa;4. 애플리케이션 연결 문자열 변경 (VIP 또는 DNS 업데이트)&#xa;5. 구 Primary 복구 후 새 Standby로 재구성 (pg_rewind 사용)&#xa;&#xa;자동 failover: Patroni + etcd/Consul, repmgr, Pacemaker 등 HA 솔루션 사용" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="90" y="710" width="1000" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>