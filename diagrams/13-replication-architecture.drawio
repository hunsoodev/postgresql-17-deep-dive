        <mxCell id="replay_arrow" value="WAL 재생" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="startup_process" target="datafiles_standby">
