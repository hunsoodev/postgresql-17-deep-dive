        <mxCell id="t3_start" value="T3 BEGIN&#xa;XID=102" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="80" height="40" as="geometry" />
