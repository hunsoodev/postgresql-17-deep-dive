        <mxCell id="pgdata_tree" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="400" height="400" as="geometry" />
        </mxCell>

        <mxCell id="tree_content" value="$PGDATA/&#xa;├── base/                    # 데이터베이스 파일&#xa;│   ├── 1/                  # template1 (OID=1)&#xa;│   ├── 13483/              # postgres DB&#xa;│   │   ├── 1247           # pg_type 테이블&#xa;│   │   ├── 1249           # pg_attribute&#xa;│   │   └── 16384          # 사용자 테이블&#xa;│   └── 13484/              # 다른 DB&#xa;│&#xa;├── global/                 # 전역 테이블&#xa;│   ├── 1262               # pg_database&#xa;│   └── 1260               # pg_authid&#xa;│&#xa;├── pg_wal/                 # WAL 세그먼트 파일&#xa;│   ├── 000000010000000000000001&#xa;│   ├── 000000010000000000000002&#xa;│   └── archive_status/    # 아카이브 상태&#xa;│&#xa;├── pg_tblspc/              # 테이블스페이스 심볼릭 링크&#xa;│&#xa;├── pg_xact/                # 트랜잭션 커밋 상태 (CLOG)&#xa;│&#xa;├── pg_multixact/           # 다중 트랜잭션 상태&#xa;│&#xa;├── pg_stat/                # 통계 정보&#xa;│&#xa;├── pg_logical/             # 논리 복제 정보&#xa;│&#xa;├── postgresql.conf         # 설정 파일&#xa;├── pg_hba.conf             # 접근 제어&#xa;└── postmaster.pid          # PID 파일" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="650" y="130" width="380" height="380" as="geometry" />
        </mxCell>

